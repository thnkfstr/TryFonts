<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>

    <RootNamespace>TryFonts.App</RootNamespace>
    <AssemblyName>TryFonts</AssemblyName>

    <!-- Avalonia XAML compiler requires BuiltInComInteropSupport on Windows -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>

    <!-- Windows DPI manifest -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Windows application icon -->
    <ApplicationIcon>Assets\TryFonts.ico</ApplicationIcon>

    <Authors>Ben Adams</Authors>
    <Copyright>Copyright (c) Ben Adams</Copyright>
    <Product>Try Fonts</Product>
    <Description>Preview text in any installed font. Offline, no tracking.</Description>
    <PackageProjectUrl>https://github.com/ben-adams1/TryFonts</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia core -->
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />

    <!-- MVVM source generators -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />

    <!-- SkiaSharp for cross-platform font enumeration.
         SkiaSharp is a transitive dependency of Avalonia; we reference it explicitly
         to call SKFontManager directly. -->
    <PackageReference Include="SkiaSharp" Version="2.88.9" />

    <!-- Pin Tmds.DBus.Protocol to the patched version (GHSA-xrw6-gwf8-vvr9).
         Avalonia pulls this in transitively for Linux D-Bus support; 0.20.0 is
         vulnerable to signal spoofing and resource exhaustion by malicious D-Bus peers.
         Pinning here overrides the transitive version on all platforms. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TryFonts.Core\TryFonts.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Trimming roots: publish passes -p:PublishTrimmed=true (see tools/ and CI).
         The XAML uses reflection bindings, which the trimmer cannot see, so our own
         assemblies must be kept whole. Avalonia and the BCL are trim-annotated and
         shrink safely. These items are inert when trimming is off, so dev builds
         and tests are unaffected. -->
    <TrimmerRootAssembly Include="TryFonts" />
    <TrimmerRootAssembly Include="TryFonts.Core" />
  </ItemGroup>

  <ItemGroup>
    <!-- AXAML files must be AvaloniaResource so the XAML compiler processes them -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

</Project>
